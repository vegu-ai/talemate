{
  "title": "Director Action Assess Visibility",
  "id": "ee6a849b-5187-4183-9afd-777684fd7616",
  "properties": {
    "name": "assess_visibility",
    "description": "Only on an explicit user request, assess Known by visibility for all attributes or all details of one character, or selected world entries. Best effort; preserve intentional restrictions unless the user explicitly requests reassessment. Report mixed public/private entries for manual splitting. Never use as an automatic sweep.",
    "instructions": "Assess only the scope the user requested. Use scope=attributes or details with one character, or scope=world_entries with explicit world entry names/Context IDs. Maximum 32 eligible entries per action (restricted and empty entries are excluded first). Carry the user goal and relevant supplied context in instructions. Set reassess=true only if the user explicitly asks to reconsider existing restrictions; otherwise false. Do not grant knowledge or make anyone forget. This action runs one assessment request and uses the normal batch write confirmation.",
    "example_json": "[{\"scope\": \"attributes\", \"character\": \"Alice\", \"world_entries\": [], \"instructions\": \"Assess which attributes are common knowledge and which are private.\", \"reassess\": false}]",
    "allow_concurrent": false
  },
