{% import "decision-visual-selection.jinja2" as visual %}
{% set threshold = 0.9 %}
{{ visual.select("avatar-selection", state, slot="avatar", kind="portrait",
    current=state.current_avatar, assets=state.portraits, threshold=threshold,
    fits_current="Does the current avatar still fit this character in this message? Judge the portrait name and tags against the character's appearance and situation. If there is no current avatar, answer no.",
    which="Which existing portrait fits this character in this message? Choose none if none fits well.",
    none_fits="None of the existing portraits fits well; use the usual selection or generation request.") }}
