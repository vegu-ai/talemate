{% set r = decide("editor-repetition",
    state={"passage": passage, "history": last3},
    questions={"repeats": {
        "type": "noul",
        "instructions": "Does this passage repeat an earlier story beat?"
    }}) %}
{% set threshold = decision_checks[0].threshold %}
{% if r.answers.repeats.p_true >= threshold %}
  {{ decision_result(agent_action("editor", "revision_rewrite",
      info=info, decision_findings=[{
          "passage_id": "s1", "kind": "repetition", "text": passage,
          "instructions": "Remove the repeated story beat."
      }],
      _decision=r)) }}
{% else %}
  {{ decision_outcome(r, "no_action", reason="below_threshold",
      threshold=threshold) }}
  {{ decision_result(info.text) }}
{% endif %}
