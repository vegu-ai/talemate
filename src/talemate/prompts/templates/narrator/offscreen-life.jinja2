{#-
Extractors:
  - response: AsIsExtractor()

Override example:
  {{ set_anchor_extractor("response", "<MY_TAG>", "</MY_TAG>") }}
  {{ set_as_is_extractor("response") }}
-#}
{% set rendered_context %}
{% with characters=[character], knowledge_viewer=character.name, include_dialogue_instructions=False %}
{% include "character-context.jinja2" %}
<|SECTION:CONTEXT|>
{% with include_scenario_premise=True, include_scene_intent=agent_config("narrator.content.use_scene_intent"), exclude_phase_intent=True %}
{% include "extra-context-static.jinja2" %}
{% endwith %}
<|CLOSE_SECTION|>
{% include "world-state-snapshot.jinja2" %}
{% endwith %}
{% if known_facts %}
<|SECTION:KNOWN FACTS|>
{% for fact in known_facts %}{{ fact }}
{% endfor %}
<|CLOSE_SECTION|>
{% endif %}
{% endset %}
{% set rendered_task %}
<|SECTION:TASK|>
{{ character.name }} was away from the scene for {{ elapsed }} and has just returned. The scene above shows only their own knowledge. Write what they did during the absence as a short account in the past tense. Respect established departure intent and arrival constraints. Invent only experiences they could have had on their own; do not give them knowledge of the scene they missed. Plain prose, no dialogue, no new arrival action.

{{ extra_instructions }}
{% include "response-length.jinja2" %}
<|CLOSE_SECTION|>
{% endset %}
{% set history_budget = [0, max_tokens-(response_length|default(192))-count_tokens(rendered_context)-count_tokens(rendered_task)-300]|max %}
{{ rendered_context }}
<|SECTION:SCENE|>
{% for line in scene.context_history(budget=history_budget, perspective=character.name, stored_views=character_knowledge_enabled(scene)) %}
{{ line }}
{% endfor %}
<|CLOSE_SECTION|>
{{ rendered_task }}
