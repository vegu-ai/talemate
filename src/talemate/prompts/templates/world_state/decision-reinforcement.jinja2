{% set threshold = 0.9 %}
{% set answers = ask("tracked-state-update", state=state, questions={"changed": yes_no(
    "Has the scene since the last update changed this tracked state's answer, or does the previous answer conflict with the current scene? Judge the question for the specified character, or the world when no character is specified. Consider the update instructions.",
    threshold=threshold
)}) %}
{% set unchanged = answers.changed.no %}
{{ note("keep_state" if unchanged else "fallback", "confident_no_change" if unchanged else "update_needed_or_uncertain", answers.changed) }}
{{ resolve({"state": false if unchanged else none}) }}
