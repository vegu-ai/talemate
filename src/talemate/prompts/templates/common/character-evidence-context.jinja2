{#- evidence_part: "all" (default), "stable" (authored entries only) or "current" (everything else) -#}
{% set _part = evidence_part|default("all") %}
{% if _part == "all" %}{% set _authored = evidence.authored %}
{% elif _part == "stable" %}{% set _authored = (evidence.authored or [])|rejectattr("reinforcement")|list %}
{% else %}{% set _authored = (evidence.authored or [])|selectattr("reinforcement")|list %}
{% endif %}
{% if _part == "stable" %}
{% if not evidence.unavailable and _authored %}
<|SECTION:AUTHORED KNOWLEDGE FOR {{ evidence.character|upper }}|>
This is the authored part of {{ evidence.character }}'s available evidence. The rest of {{ evidence.character }}'s evidence follows later.{% if _authored|selectattr("label")|list %} Labelled items start with their label in brackets.{% endif %}

{% for item in _authored -%}
{% if item.label %}[{{ item.label }}]
{% endif %}{{ item.text|trim }}
---
{% endfor -%}
<|CLOSE_SECTION|>
{% endif %}
{% else %}
<|SECTION:CHARACTER EVIDENCE FOR {{ evidence.character|upper }}|>
{% if evidence.unavailable %}Evidence is unavailable; do not infer this character's knowledge from reader context.{% else -%}
This is {{ evidence.character }}'s available evidence, including last-known context. It is not an omniscient account of the world.{% if _part == "current" and (evidence.authored or [])|rejectattr("reinforcement")|list %} Authored knowledge for {{ evidence.character }} is listed earlier.{% endif %}{% if _authored|selectattr("label")|list %} Labelled items start with their label in brackets.{% endif %}

{% if _authored -%}
### Authored knowledge
{% for item in _authored -%}
{% if item.label %}[{{ item.label }}]
{% endif %}{{ item.text|trim }}
---
{% endfor -%}
{% endif -%}
{% if evidence.history -%}
### {{ evidence.character }}'s history, oldest first
{% for text in evidence.history -%}
{{ text|trim }}
---
{% endfor -%}
{% endif -%}
### Last-known snapshot
{{ json(evidence.snapshot) }}
{% endif %}
<|CLOSE_SECTION|>
{% endif %}
